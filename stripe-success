<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Welcome to Stirrup — Upgrade successful</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:#f9f8f5;color:#1a1a18;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem}
.card{background:#fff;border:1px solid #e8e6e0;border-radius:16px;padding:2.5rem;width:100%;max-width:440px;text-align:center}
.icon{width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 1.25rem}
.icon-success{background:#e0f5ed}
.icon-error{background:#fcebeb}
.title{font-size:22px;font-weight:600;margin-bottom:8px}
.sub{font-size:14px;color:#5a5a55;line-height:1.6;margin-bottom:1.5rem}
.badge{display:inline-block;font-size:13px;padding:4px 14px;border-radius:20px;font-weight:500;margin-bottom:1.25rem}
.badge-pro{background:#e0f5ed;color:#0f6e47}
.badge-barn{background:#faeeda;color:#633806}
.btn{width:100%;padding:12px;border:none;border-radius:10px;font-size:14px;font-weight:500;cursor:pointer;font-family:'Inter',sans-serif;margin-bottom:8px}
.btn-primary{background:#1D9E75;color:#fff}
.btn-primary:hover{background:#178a64}
.btn-ghost{background:transparent;border:1px solid #d4d2cb;color:#5a5a55}
.btn-ghost:hover{background:#f0efe9}
.loading{color:#8a8a85;font-size:14px}
.features{background:#f9f8f5;border-radius:10px;padding:1rem;margin-bottom:1.25rem;text-align:left}
.feature-item{display:flex;align-items:center;gap:8px;font-size:13px;color:#3a3a35;padding:4px 0}
.feature-check{color:#1D9E75;font-weight:600;flex-shrink:0}
</style>
</head>
<body>
<div class="card" id="card">
  <div style="text-align:center;padding:2rem;color:#8a8a85;font-size:14px" id="loading-view">
    <div style="font-size:28px;margin-bottom:12px">⏳</div>
    Setting up your account…
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://mfinlbqfowymmklhkuhb.supabase.co';
const SUPABASE_KEY='sb_publishable_PcwbX1YoncwnrHobFmpAIA_L39K4XfK';
const db=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

const tierFeatures={
  pro:[
    'Unlimited bookings',
    'Square payment links',
    'Automated rider reminders',
    'Horse assignment prompts',
    'Late payment warnings'
  ],
  barn:[
    'Everything in Pro',
    'Unlimited staff trainers',
    'Staff availability scheduling',
    'Full barn management'
  ]
};

async function init(){
  const params=new URLSearchParams(window.location.search);
  const tier=params.get('tier');
  const card=document.getElementById('card');

  if(!tier||!['pro','barn'].includes(tier)){
    card.innerHTML=`
      <div class="icon icon-error">⚠️</div>
      <div class="title">Something went wrong</div>
      <div class="sub">We couldn't determine your plan. Please contact support or try upgrading again.</div>
      <button class="btn btn-primary" onclick="window.location.href='dashboard.html'">Go to dashboard</button>`;
    return;
  }

  const {data:{user}}=await db.auth.getUser();
  if(!user){
    window.location.href='login.html?redirect=stripe-success.html?tier='+tier;
    return;
  }

  const {error}=await db.from('trainers').update({tier}).eq('id',user.id);

  if(error){
    card.innerHTML=`
      <div class="icon icon-error">⚠️</div>
      <div class="title">Upgrade failed</div>
      <div class="sub">Your payment was processed but we couldn't update your account. Please contact support with your email address.</div>
      <button class="btn btn-primary" onclick="window.location.href='dashboard.html'">Go to dashboard</button>`;
    return;
  }

  // Log activity
  await db.from('activity_log').insert({
    trainer_id:user.id,
    action:'plan_upgraded',
    entity_type:'account',
    entity_name:tier==='barn'?'Barn':'Pro',
    meta:{tier}
  });

  const tierName=tier==='barn'?'Barn':'Pro';
  const features=tierFeatures[tier]||[];
  const badgeClass=tier==='barn'?'badge-barn':'badge-pro';

  card.innerHTML=`
    <div class="icon icon-success">🎉</div>
    <div class="title">Welcome to Stirrup ${tierName}!</div>
    <span class="badge ${badgeClass}">${tierName} plan active</span>
    <div class="features">
      ${features.map(f=>`<div class="feature-item"><span class="feature-check">✓</span>${f}</div>`).join('')}
    </div>
    <div class="sub">Your account has been upgraded. Everything is ready to go.</div>
    <button class="btn btn-primary" onclick="window.location.href='dashboard.html'">Go to dashboard →</button>`;
}

init();
</script>
</body>
</html>
