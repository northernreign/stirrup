<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Set new password — Stirrup</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:#f9f8f5;color:#1a1a18;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem}
.card{background:#fff;border:1px solid #e8e6e0;border-radius:16px;padding:2rem;width:100%;max-width:420px}
.logo{font-size:18px;font-weight:600;color:#1a1a18;text-align:center;margin-bottom:1.5rem}
.title{font-size:20px;font-weight:600;margin-bottom:6px}
.sub{font-size:14px;color:#5a5a55;margin-bottom:1.5rem;line-height:1.5}
.field{margin-bottom:12px}
.field label{display:block;font-size:12px;font-weight:500;color:#3a3a35;margin-bottom:4px}
.field input{width:100%;padding:10px 12px;border:1px solid #d4d2cb;border-radius:8px;font-size:14px;font-family:'Inter',sans-serif;outline:none;background:#fff;color:#1a1a18;transition:border .15s}
.field input:focus{border-color:#1D9E75}
.btn-primary{width:100%;padding:11px;background:#1D9E75;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;color:#fff;font-family:'Inter',sans-serif;margin-top:4px}
.btn-primary:hover{background:#178a64}
.btn-primary:disabled{background:#9ad4be;cursor:not-allowed}
.error{background:#fcebeb;color:#c0392b;font-size:13px;padding:10px 12px;border-radius:8px;margin-bottom:14px;display:none}
.done-wrap{text-align:center;padding:1rem 0;display:none}
.done-icon{width:56px;height:56px;border-radius:50%;background:#e0f5ed;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 1rem}
.invalid-wrap{text-align:center;padding:1rem 0;display:none}
</style>
</head>
<body>
<div class="card">
  <div class="logo">Stirrup</div>

  <div id="loading-view">
    <div style="text-align:center;padding:2rem;color:#8a8a85;font-size:14px">Verifying reset link…</div>
  </div>

  <div id="reset-view" style="display:none">
    <div class="title">Set a new password</div>
    <div class="sub">Choose a strong password for your Stirrup account.</div>
    <div class="error" id="error"></div>
    <div class="field"><label>New password</label><input type="password" id="password" placeholder="At least 8 characters"></div>
    <div class="field"><label>Confirm password</label><input type="password" id="confirm" placeholder="Repeat your password"></div>
    <button class="btn-primary" id="save-btn" onclick="handleSave()">Set new password →</button>
  </div>

  <div class="done-wrap" id="done-view">
    <div class="done-icon">✓</div>
    <div style="font-size:20px;font-weight:600;margin-bottom:8px">Password updated</div>
    <div style="font-size:14px;color:#5a5a55;margin-bottom:1.5rem">Your password has been changed. You can now log in.</div>
    <button class="btn-primary" onclick="window.location.href='login.html'">Go to login →</button>
  </div>

  <div class="invalid-wrap" id="invalid-view">
    <div style="font-size:32px;margin-bottom:12px">⚠️</div>
    <div style="font-size:16px;font-weight:600;margin-bottom:8px">Invalid or expired link</div>
    <div style="font-size:14px;color:#5a5a55;margin-bottom:1.5rem">This password reset link has expired or already been used. Request a new one.</div>
    <button class="btn-primary" onclick="window.location.href='forgot-password.html'">Request new link →</button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://mfinlbqfowymmklhkuhb.supabase.co';
const SUPABASE_KEY='sb_publishable_PcwbX1YoncwnrHobFmpAIA_L39K4XfK';
const db=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

async function init(){
  const {data:{session},error}=await db.auth.getSession();
  document.getElementById('loading-view').style.display='none';
  if(error||!session){
    document.getElementById('invalid-view').style.display='block';
    return;
  }
  document.getElementById('reset-view').style.display='block';
}

async function handleSave(){
  const password=document.getElementById('password').value;
  const confirm=document.getElementById('confirm').value;
  if(!password||password.length<8){
    document.getElementById('error').textContent='Password must be at least 8 characters.';
    document.getElementById('error').style.display='block';return;
  }
  if(password!==confirm){
    document.getElementById('error').textContent='Passwords do not match.';
    document.getElementById('error').style.display='block';return;
  }
  const btn=document.getElementById('save-btn');
  btn.disabled=true;btn.textContent='Saving…';
  const {error}=await db.auth.updateUser({password});
  if(error){
    document.getElementById('error').textContent=error.message;
    document.getElementById('error').style.display='block';
    btn.disabled=false;btn.textContent='Set new password →';return;
  }
  document.getElementById('reset-view').style.display='none';
  document.getElementById('done-view').style.display='block';
}

init();
</script>
</body>
</html>
